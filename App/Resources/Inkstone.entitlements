<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<!-- Vaults are folders the user picks anywhere on disk. -->
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>
	<!-- Required to restore vault access after relaunch via bookmarks. -->
	<key>com.apple.security.files.bookmarks.app-scope</key>
	<true/>
	<!-- Outbound only: GitHub sync, and Sparkle's update downloads. Because the
	     app has this, Sparkle's Downloader XPC service is unnecessary. -->
	<key>com.apple.security.network.client</key>
	<true/>
	<!-- Lets the sandboxed app reach Sparkle's installer tools. Both names are
	     required and both are derived from the bundle id; without them the
	     updater fails silently rather than reporting anything. Accepted for
	     Developer ID distribution, which is how this ships — the Mac App Store
	     would reject them. -->
	<key>com.apple.security.temporary-exception.mach-lookup.global-name</key>
	<array>
		<string>$(PRODUCT_BUNDLE_IDENTIFIER)-spks</string>
		<string>$(PRODUCT_BUNDLE_IDENTIFIER)-spki</string>
	</array>
	<key>com.apple.developer.icloud-container-identifiers</key>
	<array>
		<string>iCloud.com.orris.inkstone</string>
	</array>
	<key>com.apple.developer.ubiquity-container-identifiers</key>
	<array>
		<string>iCloud.com.orris.inkstone</string>
	</array>
	<!-- Carries the GitHub repository, branch and schedule between the user's
	     devices, so a second device is the same vault rather than a fresh
	     setup. The token travels separately, in iCloud Keychain. -->
	<key>com.apple.developer.ubiquity-kvstore-identifier</key>
	<string>$(TeamIdentifierPrefix)$(CFBundleIdentifier)</string>
	<key>com.apple.developer.icloud-services</key>
	<array>
		<string>CloudDocuments</string>
	</array>
</dict>
</plist>
