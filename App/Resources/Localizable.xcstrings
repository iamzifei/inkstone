    "Stopped: GitHub reported no files, but %@ were synced there before. Syncing now would delete them from this device. Check the repository and branch, then sync again.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stopped: GitHub reported no files, but %@ were synced there before. Syncing now would delete them from this device. Check the repository and branch, then sync again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已停止：GitHub 报告没有任何文件，但之前同步过 %@ 个。现在同步会把它们从这台设备上删除。请检查仓库和分支，然后再同步。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已停止：GitHub 回報沒有任何檔案，但之前同步過 %@ 個。現在同步會把它們從這台裝置上刪除。請檢查儲存庫和分支，然後再同步。"
          }
        }
      }
    },
    "Stopped: this sync would delete %@ of %@ synced files %@. That is usually a sign the wrong folder or branch is configured rather than a deletion anyone asked for. Check them, or confirm if it is what you meant.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stopped: this sync would delete %@ of %@ synced files %@. That is usually a sign the wrong folder or branch is configured rather than a deletion anyone asked for. Check them, or confirm if it is what you meant."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已停止：这次同步会%3$@删除 %2$@ 个已同步文件中的 %1$@ 个。这通常说明配置了错误的文件夹或分支，而不是你真的想删除。请检查，或在确认无误时选择继续。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已停止：這次同步會%3$@刪除 %2$@ 個已同步檔案中的 %1$@ 個。這通常表示設定了錯誤的資料夾或分支，而不是你真的想刪除。請檢查，或在確認無誤時選擇繼續。"
          }
        }
      }
    },
