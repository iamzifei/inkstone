    "iCloud Drive is signed in, but Inkstone's storage isn't responding yet. It often sorts itself out in a minute or two — or open any folder as a vault.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud Drive is signed in, but Inkstone's storage isn't responding yet. It often sorts itself out in a minute or two — or open any folder as a vault."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud 云盘已登录，但 Inkstone 的存储空间暂时没有响应。这通常一两分钟后会自行恢复——或者直接打开任意文件夹作为仓库。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud 雲碟已登入，但 Inkstone 的儲存空間暫時沒有回應。這通常一兩分鐘後會自行恢復——或者直接開啟任意資料夾作為儲存庫。"
          }
        }
      }
    },
