        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "渲染时在中文与英文之间插入细空格，不会修改你的文件。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "算繪時在中文與英文之間插入細空格，不會修改你的檔案。"
