    "Write [[Note name]] to link to another note. The inspector on the right lists every note that links back, along with tags, the outline and a small local graph.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Write [[Note name]] to link to another note. The inspector on the right lists every note that links back, along with tags, the outline and a small local graph."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "写下 [[笔记名称]] 就能链接到另一篇笔记。右侧的检查器会列出所有链回来的笔记，还有标签、大纲和一张小型局部图谱。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "寫下 [[筆記名稱]] 就能連結到另一篇筆記。右側的檢查器會列出所有連回來的筆記，還有標籤、大綱和一張小型局部圖譜。"
          }
        }
      }
    },
