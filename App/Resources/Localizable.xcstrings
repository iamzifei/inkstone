    "API keys are stored in your Mac's Keychain, not in the app's preferences, and are not synced to your other devices.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "API keys are stored in your Mac's Keychain, not in the app's preferences, and are not synced to your other devices."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "API 密钥保存在这台 Mac 的钥匙串中，而不是应用的偏好设置里，也不会同步到你的其他设备。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "API 金鑰儲存在這台 Mac 的鑰匙圈中，而不是 App 的偏好設定裡，也不會同步到你的其他裝置。"
          }
        }
      }
    },
