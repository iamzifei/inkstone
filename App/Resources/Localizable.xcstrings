    "New Canvas (⇧⌘N) opens a free-form board: drop in notes and text cards and connect them with arrows. It is saved as a standard .canvas file.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "New Canvas (⇧⌘N) opens a free-form board: drop in notes and text cards and connect them with arrows. It is saved as a standard .canvas file."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "新建白板（⇧⌘N）会打开一块自由画布：放入笔记和文字卡片，再用箭头连起来。它保存为标准的 .canvas 文件。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "新增白板（⇧⌘N）會開啟一塊自由畫布：放入筆記和文字卡片，再用箭頭連起來。它儲存為標準的 .canvas 檔案。"
          }
        }
      }
    },
