        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這個儲存庫是一個 git 工作副本。"
          }
        }
      }
    },
    "This vault is stored locally, so iCloud does not carry it. Create a vault in iCloud Drive, or move this folder there, to sync it across your devices.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This vault is stored locally, so iCloud does not carry it. Create a vault in iCloud Drive, or move this folder there, to sync it across your devices."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这个仓库存储在本地，iCloud 不会同步它。在 iCloud 云盘中创建仓库，或把这个文件夹移到那里，即可跨设备同步。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這個儲存庫儲存在本機，iCloud 不會同步它。在 iCloud 雲碟中建立儲存庫，或把這個資料夾移到那裡，即可跨裝置同步。"
          }
        }
      }
