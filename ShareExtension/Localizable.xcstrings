    "Not saved": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not saved"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未保存"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "未儲存"
          }
        }
      }
    },
    "Open Inkstone and choose a vault: what you share waits here until then.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Inkstone and choose a vault: what you share waits here until then."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请先打开 Inkstone 选择一个仓库：在那之前，分享的内容会先在这里等着。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請先開啟 Inkstone 選擇一個資料庫：在那之前，分享的內容會先在這裡等著。"
          }
        }
      }
    },
    "Save": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Save"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保存"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "儲存"
          }
        }
      }
    },
    "Saved the next time Inkstone opens: in a knowledge base, as a note in its inbox; otherwise in the vault's Inbox note.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saved the next time Inkstone opens: in a knowledge base, as a note in its inbox; otherwise in the vault's Inbox note."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "下次打开 Inkstone 时保存：在知识库里，作为一篇笔记放进收件箱；在其他仓库里，写进 Inbox 笔记。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "下次開啟 Inkstone 時儲存：在知識庫裡，作為一篇筆記放進收件匣；在其他資料庫裡，寫進 Inbox 筆記。"
          }
        }
      }
    },
    "These weren't added. If they are in iCloud, download them first, then share again.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These weren't added. If they are in iCloud, download them first, then share again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这些没有添加。如果它们在 iCloud 里，请先下载，再重新分享。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這些沒有加入。如果它們在 iCloud 裡，請先下載，再重新分享。"
          }
        }
      }
    }
  },
  "version": "1.0"
}