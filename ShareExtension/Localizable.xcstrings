    "Open Inkstone and choose a vault: what you share waits here until then, and goes into the vault's Inbox note.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Inkstone and choose a vault: what you share waits here until then, and goes into the vault's Inbox note."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开 Inkstone 并选择一个仓库：在那之前，你分享的内容会先在这里等着，之后放进仓库的 Inbox 笔记。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "打開 Inkstone 並選擇一個儲存庫：在那之前，你分享的內容會先在這裡等著，之後放進儲存庫的 Inbox 筆記。"
          }
        }
      }
    },
    "Save": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Save"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保存"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "儲存"
          }
        }
      }
    },
    "Saved to the Inbox note of your vault the next time Inkstone opens.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saved to the Inbox note of your vault the next time Inkstone opens."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "下次打开 Inkstone 时，会保存到库中的 Inbox 笔记。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "下次打開 Inkstone 時，會儲存到庫中的 Inbox 筆記。"
          }
        }
      }
    }
  },
  "version": "1.0"
}