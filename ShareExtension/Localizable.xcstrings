    "Added to your knowledge base's inbox and filed the next time Inkstone opens (in another vault: its attachments folder).": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Added to your knowledge base's inbox and filed the next time Inkstone opens (in another vault: its attachments folder)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "下次打开 Inkstone 时放进知识库的收件箱并自动整理（其他仓库：放进附件文件夹）。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "下次開啟 Inkstone 時放進知識庫的收件匣並自動整理（其他資料庫：放進附件資料夾）。"
          }
        }
      }
    },
    "Cancel": {
      "localizations": {
