# Generated by XcodeGen from project.yml — run `xcodegen generate` to recreate.
# Kept out of git so the spec is the single source of truth and merges never
# conflict on a 5,000-line pbxproj.
Inkstone.xcodeproj/

# Build products
# Every derived-data directory, however it is suffixed. Listing them one by one
# meant a new one (.build-ios) slipped straight into a commit.
.build*/
DerivedData/
*.xcuserdatadata
xcuserdata/
*.xcscmblueprint
*.xccheckout

# Swift Package Manager
.swiftpm/
Package.pins

# macOS
.DS_Store

# Local-only test harness marker
/tmp-inkstone-*

# Website
# The raw screen recordings: ~15 MB per take, and every one is reproducible by
# running scripts/record-demo.sh. Only the encoded hero (site/assets/video) is
# committed, because that is what gets served.
assets/footage/
.playwright-mcp/
__pycache__/
.sparkle-tools/

# fastlane
fastlane/report.xml
fastlane/Preview.html
fastlane/test_output/
.asc/metadata/
